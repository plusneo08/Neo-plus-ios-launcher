<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Wallpaper theme: the system wallpaper shows through, so every glass panel is truly translucent -->
    <style name="Theme.Neo" parent="@android:style/Theme.Material.Wallpaper.NoTitleBar">
        <item name="android:windowShowWallpaper">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>

    <!-- Invisible host for the screen-capture consent dialog -->
    <style name="Theme.Neo.Translucent" parent="@android:style/Theme.Translucent.NoTitleBar">
        <item name="android:windowAnimationStyle">@null</item>
    </style>
</resources>
