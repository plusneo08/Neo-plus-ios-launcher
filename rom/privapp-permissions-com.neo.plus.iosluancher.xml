<?xml version="1.0" encoding="utf-8"?>
<!-- Put at /system/etc/permissions/ (or system_ext/product) in your ROM, and the APK in /system/priv-app/NeoPlusLauncher/ -->
<permissions>
    <privapp-permissions package="com.neo.plus.iosluancher">
        <permission name="android.permission.NETWORK_AIRPLANE_MODE" />
        <permission name="android.permission.MODIFY_PHONE_STATE" />
        <permission name="android.permission.WRITE_SECURE_SETTINGS" />
        <permission name="android.permission.MODIFY_DAY_NIGHT_MODE" />
        <permission name="android.permission.BLUETOOTH_PRIVILEGED" />
        <permission name="android.permission.NETWORK_SETTINGS" />
        <permission name="android.permission.MEDIA_CONTENT_CONTROL" />
        <permission name="android.permission.SHUTDOWN" />
        <permission name="android.permission.REBOOT" />
    </privapp-permissions>
</permissions>
